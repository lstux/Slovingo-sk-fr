    {
      "type": "hr"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "🎯 La formule à retenir"
    },
    {
      "type": "paragraph",
      "text": "**20–49** → **-sať**"
    },
    {
      "type": "paragraph",
      "text": "**50–90** → **-desiat**"
    },
    {
      "type": "paragraph",
      "text": "**21–99** → diz. + unité *(soudé)*"
    },
    {
      "type": "paragraph",
      "text": "**100–900** → **-sto**"
    },
    {
      "type": "paragraph",
      "text": "**101–999** → centaine + reste *(séparé)*"
    },
    {
      "type": "paragraph",
      "text": "**1 000–999 999** → nombre + [[tisíc]] *(soudé)*"
    },
    {
      "type": "paragraph",
      "text": "**1 000 000+** → nombre + [[milión]] *(séparé)*"
    }
