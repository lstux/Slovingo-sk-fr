    {
      "type": "heading",
      "level": 3,
      "text": "🧩 Nombres de 101 à 999"
    },
    {
      "type": "paragraph",
      "text": "**La centaine forme un bloc séparé** du reste :"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "**101** = [[sto jeden]]",
        "**120** = [[sto dvadsať]]",
        "**125** = [[sto dvadsaťpäť]]",
        "**234** = [[dvesto tridsaťštyri]]",
        "**456** = [[štyristo päťdesiatšesť]]",
        "**789** = [[sedemsto osemdesiatdeväť]]",
        "**999** = [[deväťsto deväťdesiatdeväť]]"
      ]
    },
    {
      "type": "hr"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "🏔️ Les milliers (1 000 à 999 999)"
    },
    {
      "type": "table",
      "columns": [
        "Číslo",
        "Slovenčina"
      ],
      "rows": [
        [
          "1 000",
          "[[tisíc]]"
        ],
        [
          "2 000",
          "[[dvetisíc]]"
        ],
        [
          "3 000",
          "[[tritisíc]]"
        ],
        [
          "5 000",
          "[[päťtisíc]]"
        ],
        [
          "10 000",
