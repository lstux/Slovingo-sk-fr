    {
      "type": "audio-card",
      "phrase": "Ako sa dostanem na stanicu?",
      "speaker": null,
      "natural": "Comment est-ce que j'arrive à la gare ?",
      "literal": [
        "ako = comment · sa dostanem = j'arrive, je me rends · na stanicu = à la gare"
