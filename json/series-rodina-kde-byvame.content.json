          "l'appartement"
        ],
        [
          "spolu",
          "ensemble"
        ],
        [
          "blízko",
          "près"
        ]
      ],
      "speakable_column": 0
    },
    {
      "type": "hr"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "La grammaire du jour"
    },
    {
      "type": "heading",
      "level": 3,
      "text": "Habiter — bývať"
    },
    {
      "type": "table",
      "columns": [
        "Slovaque",
        "Français"
      ],
      "rows": [
        [
          "ja bývam",
          "j'habite"
        ],
        [
          "ty bývaš",
          "tu habites"
        ],
        [
          "on / ona býva",
          "il / elle habite"
        ],
        [
          "my bývame",
          "nous habitons"
        ],
        [
          "vy bývate",
          "vous habitez"
        ],
        [
          "oni bývajú",
          "ils / elles habitent"
        ]
      ],
      "speakable_column": 0
    },
    {
      "type": "heading",
      "level": 3,
      "text": "Après « v », le mot change"
    },
    {
      "type": "table",
      "columns": [
        "Slovaque",
        "Français"
      ],
      "rows": [
        [
          "mesto → v meste",
          "en ville"
        ],
        [
          "dom → v dome",
          "dans la maison"
        ],
        [
          "byt → v byte",
          "dans l'appartement"
        ],
        [
          "Bratislava → v Bratislave",
          "à Bratislava"
        ],
        [
          "Košice → v Košiciach",
          "à Košice"
        ]
      ],
      "speakable_column": 0
    },
    {
      "type": "paragraph",
      "text": "C'est le locatif : il répond à la question « où ? » et ne s'utilise jamais sans préposition."
    },
    {
      "type": "paragraph",
      "text": "+ Attention à Košice : contrairement à Bratislava, c'est un nom toujours pluriel en slovaque (comme Piešťany), et il se décline donc comme un pluriel — « v Košiciach », jamais « v Košice ». Bonne nouvelle pour la logique du tableau ci-dessus, mauvaise nouvelle pour la mémoire."
    },
    {
      "type": "hr"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Des phrases"
    },
    {
