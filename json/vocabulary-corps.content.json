    {
      "type": "heading",
      "level": 2,
      "text": "3. Parler de son corps"
    },
    {
      "type": "audio-card",
      "phrase": "Bolí ma hlava.",
      "speaker": null,
      "natural": "J'ai mal à la tête.",
      "literal": [
        "bolí ma = ça me fait mal · hlava = tête"
      ],
      "notes": []
    },
    {
      "type": "audio-card",
      "phrase": "Bolia ma nohy.",
      "speaker": null,
      "natural": "J'ai mal aux jambes.",
      "literal": [
        "bolia ma = ça me fait mal (pluriel) · nohy = jambes"
      ],
      "notes": []
    },
    {
      "type": "paragraph",
      "text": "+ \"bolí\" au singulier, \"bolia\" au pluriel : le verbe s'accorde avec la partie du corps qui fait mal, pas avec la personne."
    },
    {
      "type": "audio-card",
      "phrase": "Mám dlhé vlasy.",
