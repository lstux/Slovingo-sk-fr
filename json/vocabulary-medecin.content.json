        ],
        [
          "sirup",
          "sirop"
        ],
        [
          "masť",
          "pommade"
        ],
        [
          "vitamín",
          "vitamine"
        ]
      ],
      "speakable_column": 0
    },
    {
      "type": "audio-card",
      "phrase": "Mám recept od lekára.",
      "speaker": null,
      "natural": "J'ai une ordonnance du médecin.",
      "literal": [
        "mám recept = j'ai une ordonnance · od lekára = du médecin"
      ],
      "notes": []
    },
    {
      "type": "hr"
    },
    {
