    {
      "type": "audio-card",
      "phrase": "Hovoríš po slovensky?",
      "speaker": null,
      "natural": "Tu parles slovaque ?",
      "literal": [
        "hovoríš = tu parles · po slovensky = en slovaque"
      ],
      "notes": []
