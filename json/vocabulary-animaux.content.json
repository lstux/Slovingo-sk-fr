    },
    {
      "type": "audio-card",
      "phrase": "Máš nejaké zvieratko?",
      "speaker": null,
      "natural": "Tu as un animal de compagnie ?",
      "literal": [
        "máš = tu as · nejaké = un quelconque · zvieratko = petit animal"
      ],
      "notes": []
    },
    {
      "type": "audio-card",
      "phrase": "Mám psa a dve mačky.",
      "speaker": null,
      "natural": "J'ai un chien et deux chats.",
      "literal": [
        "mám = j'ai · psa = chien (accusatif) · dve mačky = deux chats"
      ],
      "notes": []
    },
    {
      "type": "paragraph",
      "text": "+ \"pes\" devient \"psa\" à l'accusatif : c'est une déclinaison irrégulière fréquente, à mémoriser."
    },
    {
      "type": "audio-card",
      "phrase": "Môj pes sa volá Rex.",
      "speaker": null,
      "natural": "Mon chien s'appelle Rex.",
      "literal": [
        "môj = mon · pes = chien · sa volá = s'appelle"
      ],
      "notes": []
    },
    {
      "type": "audio-card",
      "phrase": "Bojím sa pavúkov.",
      "speaker": null,
      "natural": "J'ai peur des araignées.",
      "literal": [
        "bojím sa = j'ai peur (de) · pavúkov = araignées (génitif pluriel)"
      ],
      "notes": []
