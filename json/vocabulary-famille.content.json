      "notes": []
    },
    {
      "type": "audio-card",
      "phrase": "Mám jednu sestru a jedného brata.",
      "speaker": null,
      "natural": "J'ai une sœur et un frère.",
      "literal": [
        "mám = j'ai · jednu sestru = une sœur · jedného brata = un frère"
