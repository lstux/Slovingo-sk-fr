      "text": "4. Parler de sa famille"
    },
    {
      "type": "audio-card",
      "phrase": "Máš súrodencov?",
      "speaker": null,
      "natural": "Tu as des frères et sœurs ?",
      "literal": [
        "máš = tu as · súrodencov = frères et sœurs (terme général)"
