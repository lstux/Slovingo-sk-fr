      "notes": []
    },
    {
      "type": "audio-card",
      "phrase": "Moji rodičia bývajú v Košiciach.",
      "speaker": null,
      "natural": "Mes parents habitent à Košice.",
      "literal": [
        "moji = mes · rodičia = parents · bývajú = habitent"
      ],
      "notes": []
    },
    {
      "type": "audio-card",
      "phrase": "Som ženatý. / Som vydatá.",
      "speaker": null,
      "natural": "Je suis marié. / Je suis mariée.",
      "literal": [],
      "notes": [
        "\"ženatý\" s'utilise pour un homme, \"vydatá\" pour une femme : ce ne sont pas des formes du même adjectif, mais deux mots différents selon le genre."
      ]
    },
