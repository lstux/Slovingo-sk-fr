    {
      "type": "heading",
      "level": 2,
      "text": "La grammaire du jour"
    },
    {
      "type": "heading",
      "level": 3,
      "text": "Les couleurs s'accordent"
    },
    {
      "type": "table",
      "columns": [
        "Slovaque",
        "Français"
      ],
      "rows": [
        [
          "červený svetr",
          "un pull rouge (masculin)"
        ],
        [
          "červená taška",
          "un sac rouge (féminin)"
        ],
        [
