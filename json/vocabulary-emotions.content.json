    {
      "type": "audio-card",
      "phrase": "Ako sa cítiš?",
      "speaker": null,
      "natural": "Comment tu te sens ?",
      "literal": [
        "ako = comment · sa cítiš = tu te sens"
      ],
      "notes": []
    },
    {
      "type": "audio-card",
      "phrase": "Cítim sa dobre.",
      "speaker": null,
      "natural": "Je me sens bien.",
      "literal": [
        "cítim sa = je me sens · dobre = bien"
      ],
      "notes": []
    },
    {
      "type": "audio-card",
      "phrase": "Som trochu unavený.",
      "speaker": null,
      "natural": "Je suis un peu fatigué.",
