          "[[-íte]]"
        ],
        [
          "oni / ony",
          "[[-ia]]"
        ]
      ]
    },
    {
      "type": "paragraph",
      "text": "Exemples :"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "[[robiť]]",
        "[[hovoriť]]",
        "[[učiť sa]]"
      ]
    },
    {
      "type": "blockquote",
      "lines": [
        "C'est l'un des modèles de conjugaison les plus fréquents du slovaque."
      ]
    },
    {
      "type": "hr"
    },
    {
      "type": "heading",
      "level": 3,
      "text": "La négation"
    },
    {
      "type": "paragraph",
      "text": "Dans la plupart des cas, il suffit d'ajouter [[ne-]] devant le verbe."
    },
    {
      "type": "table",
      "columns": [
        "Affirmatif",
        "Négatif"
      ],
      "rows": [
        [
          "[[mám]]",
          "[[nemám]]"
        ],
        [
          "[[robím]]",
          "[[nerobím]]"
        ],
        [
          "[[hovorím]]",
          "[[nehovorím]]"
        ],
        [
          "[[chcem]]",
          "[[nechcem]]"
        ],
        [
          "[[idem]]",
          "[[nejdem]]"
        ]
      ]
    },
    {
      "type": "paragraph",
      "text": "Exception avec [[byť]] :"
    },
    {
      "type": "table",
      "columns": [
        "Affirmatif",
        "Négatif"
      ],
      "rows": [
        [
          "[[som]]",
          "[[nie som]]"
        ]
      ]
    },
    {
      "type": "hr"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "💬 Exemples"
    },
    {
      "type": "table",
      "columns": [
        "Français",
        "Slovaque"
      ],
      "rows": [
        [
          "Je suis Éric.",
          "Som Eric."
        ],
        [
          "Je suis français.",
          "Som Francúz."
        ],
        [
          "J'ai le temps.",
          "Mám čas."
        ],
        [
          "Je n'ai pas le temps.",
          "Nemám čas."
        ],
        [
          "Je parle un peu slovaque.",
          "Hovorím trochu po slovensky."
        ],
        [
          "Je fais du café.",
          "Robím kávu."
        ],
        [
          "Je veux apprendre le slovaque.",
          "Chcem sa učiť po slovensky."
        ],
        [
          "Je vais à la maison.",
          "Idem domov."
        ],
        [
          "Je ne comprends pas.",
          "Nerozumiem."
        ],
        [
          "Je ne suis pas fatigué.",
          "Nie som unavený."
        ]
      ],
      "speakable_column": 1
    },
    {
      "type": "hr"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "🎯 À retenir"
    },
    {
      "type": "paragraph",
      "text": "Essaie de connaître ces phrases presque par cœur."
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "[[Som Eric.]]",
        "[[Som Francúz.]]",
        "[[Mám čas.]]",
        "[[Nemám čas.]]",
        "[[Hovorím trochu po slovensky.]]",
        "[[Nerozumiem.]]",
        "[[Chcem sa učiť po slovensky.]]",
        "[[Idem domov.]]",
        "[[Ďakujem.]]",
        "[[Prosím.]]"
      ]
    },
    {
      "type": "hr"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "⚠️ Pièges du français"
    },
    {
      "type": "heading",
      "level": 3,
      "text": "Les pronoms sont souvent omis"
    },
    {
      "type": "paragraph",
      "text": "En français, on dit toujours :"
    },
    {
      "type": "blockquote",
      "lines": [
        "**Je** parle."
      ]
    },
    {
      "type": "paragraph",
      "text": "En slovaque, on dira très souvent simplement :"
    },
    {
      "type": "paragraph",
      "text": "[[Hovorím.]]"
    },
    {
      "type": "paragraph",
      "text": "Le [[ja]] n'est utilisé que pour insister."
    },
    {
      "type": "hr"
    },
    {
      "type": "heading",
      "level": 3,
      "text": "Le verbe [[byť]] est irrégulier"
    },
    {
      "type": "paragraph",
      "text": "On dit :"
    },
    {
      "type": "paragraph",
      "text": "[[Som.]]"
    },
    {
      "type": "paragraph",
      "text": "mais au négatif :"
    },
    {
      "type": "paragraph",
      "text": "[[Nie som.]]"
    },
    {
      "type": "paragraph",
      "text": "On ne dit **jamais** *[[Nesom]]*."
    },
    {
      "type": "hr"
    },
    {
      "type": "heading",
      "level": 3,
      "text": "Le verbe [[ísť]] est lui aussi irrégulier"
    },
    {
      "type": "paragraph",
      "text": "Il ne suit pas les mêmes terminaisons que les verbes en [[-iť]]."
    },
    {
      "type": "paragraph",
      "text": "Il faut apprendre directement :"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "[[idem]]",
        "[[ideš]]",
        "[[ide]]",
        "[[ideme]]",
        "[[idete]]",
        "[[idú]]"
      ]
    },
    {
      "type": "hr"
    },
    {
      "type": "heading",
      "level": 3,
      "text": "Tout ne se traduit pas mot à mot"
    },
    {
      "type": "paragraph",
      "text": "Par exemple :"
    },
    {
      "type": "paragraph",
      "text": "[[Chcem sa učiť po slovensky.]]"
    },
    {
      "type": "paragraph",
      "text": "se traduit littéralement par :"
    },
    {
      "type": "blockquote",
      "lines": [
        "Je veux **m'apprendre** le slovaque."
      ]
    },
    {
      "type": "paragraph",
      "text": "En français, on dira naturellement :"
    },
    {
      "type": "blockquote",
      "lines": [
        "Je veux apprendre le slovaque."
      ]
    }
  ]
}