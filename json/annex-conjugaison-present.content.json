      "text": "🔍 À remarquer"
    },
    {
      "type": "heading",
      "level": 3,
      "text": "Les verbes en [[-iť]]"
    },
    {
      "type": "paragraph",
      "text": "Beaucoup de verbes suivent ce modèle."
    },
    {
      "type": "table",
      "columns": [
        "Personne",
        "Terminaison"
      ],
      "rows": [
        [
          "ja",
          "[[-ím]]"
        ],
