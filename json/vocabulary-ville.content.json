    {
      "type": "audio-card",
      "phrase": "Choďte rovno a potom doprava.",
      "speaker": null,
      "natural": "Allez tout droit puis à droite.",
      "literal": [
        "choďte rovno = allez tout droit · potom doprava = puis à droite"
      ],
      "notes": []
    },
    {
      "type": "audio-card",
      "phrase": "Je to ďaleko odtiaľto?",
      "speaker": null,
      "natural": "C'est loin d'ici ?",
      "literal": [
        "je to ďaleko = c'est loin · odtiaľto = d'ici"
      ],
      "notes": []
    },
    {
      "type": "paragraph",
      "text": "+ \"doprava\" (à droite) et \"doľava\" (à gauche) sont des adverbes de direction, différents de \"pravá/ľavá strana\" qui décrivent un côté ou un objet."
    },
