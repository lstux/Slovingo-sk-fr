    {
      "type": "audio-card",
      "phrase": "Prepáčte, kde je najbližšia lekáreň?",
      "speaker": null,
      "natural": "Excusez-moi, où est la pharmacie la plus proche ?",
      "literal": [
        "prepáčte = excusez-moi · kde je = où est · najbližšia lekáreň = la pharmacie la plus proche"
