          "C'est une pièce."
        ],
        [
          "To sú izby.",
          "Ce sont des pièces."
        ]
      ],
      "speakable_column": 0
    },
    {
      "type": "hr"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Des phrases"
    },
