  "content": [
    {
      "type": "paragraph",
      "text": "Andrea, Eric et Marek essaient de trouver un créneau commun. Tout le vocabulaire de la série y passe. Aucun mot nouveau, sauf ceux signalés dans les remarques."
    },
    {
      "type": "hr"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Les personnages"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "👩 Andrea, qui organise",
        "👦 Eric, le Français",
        "👨 Marek, collègue d'Andrea"
      ]
    },
    {
      "type": "paragraph",
      "text": "Eric et Andrea se vouvoient. Andrea et Marek se tutoient."
    },
    {
      "type": "hr"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Le dialogue"
    },
    {
      "type": "audio-card",
      "phrase": "Eric, kedy máte čas?",
      "speaker": "👩",
      "natural": "Eric, quand avez-vous le temps ?",
      "literal": [
        "kedy = quand",
        "máte = avez-vous",
        "čas = le temps"
      ],
      "notes": []
    },
    {
      "type": "audio-card",
      "phrase": "V pondelok poobede.",
      "speaker": "👦",
      "natural": "Lundi après-midi.",
      "literal": [
        "V pondelok = lundi",
        "poobede = l'après-midi"
