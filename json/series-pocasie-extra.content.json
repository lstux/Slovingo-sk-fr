    {
      "type": "audio-card",
      "phrase": "Na jar prší často, tak vždy nosím dáždnik.",
      "speaker": null,
      "natural": "Au printemps il pleut souvent, alors je porte toujours un parapluie.",
      "literal": [
        "Na jar = au printemps",
