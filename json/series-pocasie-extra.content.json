      "notes": []
    },
    {
      "type": "audio-card",
      "phrase": "Na jeseň padá lístie a oblaky sú tmavšie.",
      "speaker": null,
      "natural": "En automne les feuilles tombent et les nuages sont plus sombres.",
      "literal": [
        "Na jeseň = en automne",
        "padá = tombe",
        "lístie = les feuilles",
        "a = et",
        "oblaky = les nuages",
        "sú = sont",
