      "notes": []
    },
    {
      "type": "audio-card",
      "phrase": "V zime musím nosiť kabát, šál a rukavice.",
      "speaker": null,
      "natural": "En hiver je dois porter un manteau, une écharpe et des gants.",
      "literal": [
        "V zime = en hiver",
        "musím nosiť = je dois porter",
        "kabát = un manteau",
        "šál = une écharpe",
        "a = et",
        "rukavice = des gants"
      ],
      "notes": []
    },
    {
      "type": "audio-card",
      "phrase": "Ak bude slnečno na víkend, pôjdeme na turistiku.",
      "speaker": null,
      "natural": "S'il fait beau le week-end, nous irons randonner.",
      "literal": [
