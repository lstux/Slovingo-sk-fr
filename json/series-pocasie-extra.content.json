      "notes": []
    },
    {
      "type": "audio-card",
      "phrase": "Toto leto je horúčava, teplota je tridsať stupňov.",
      "speaker": null,
      "natural": "Cet été il fait canicule, la température est de trente degrés.",
      "literal": [
        "Toto leto = cet été",
        "je horúčava = il fait canicule",
        "teplota = la température",
