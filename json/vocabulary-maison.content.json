    {
      "type": "audio-card",
      "phrase": "Bývam v byte na treťom poschodí.",
      "speaker": null,
      "natural": "J'habite dans un appartement au troisième étage.",
      "literal": [
        "bývam = j'habite · v byte = dans un appartement · na treťom poschodí = au troisième étage"
